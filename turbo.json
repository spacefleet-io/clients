{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "SF_PHSI_DEBUG",
    "SF_LIBRARY_SYNC_DEBUG"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@space/badger-desktop#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "@space/parrot-desktop#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SF_LANE",
        "SF_LOCAL_METADATA",
        "SF_USER_DATA_PATH",
        "SF_DEVTOOLS_PORT",
        "SF_DEV_SERVER_URL",
        "SF_API_BASE_URL",
        "SF_DEV_API_BASE_URL",
        "SF_RUNTIME_BASE_URL",
        "SF_RUNTIME_SPAWN_MODE",
        "SPACEFLEET_RUNTIME_DATA_DIR",
        "SF_DUMMY_STORAGE_DIR",
        "SF_DEV_TICKET_KEY",
        "SF_METADATA_TICKETS",
        "SF_LOG_LEVEL",
        "SF_LOG_PRETTY",
        "SF_BUGSINK_DSN_BADGER_DESKTOP",
        "SF_BUGSINK_DSN_PARROT_DESKTOP",
        "VITE_METADATA_URL",
        "VITE_METADATA_TICKETS",
        "VITE_API_BASE_URL",
        "VITE_SF_DEV_TICKET_KEY",
        "EXPO_PUBLIC_METADATA_URL",
        "PARROT_API_BASE_URL",
        "PARROT_METADATA_TICKETS",
        "PARROT_WEB_PORT",
        "WEB_API_PROXY_TARGET",
        "LOG_LEVEL",
        "LOG_PRETTY",
        "XDG_CONFIG_HOME",
        "APPDATA"
      ]
    },
    "db:push": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "@space/desktop-platform-linux#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/badger/desktop/electron-builder.config.mjs",
        "$TURBO_ROOT$/apps/badger/desktop/scripts/**",
        "$TURBO_ROOT$/apps/parrot/desktop/electron-builder.config.mjs",
        "$TURBO_ROOT$/apps/parrot/desktop/scripts/**",
        "$TURBO_ROOT$/packages/desktop-platform/packaging/**",
        "$TURBO_ROOT$/packages/desktop-platform-macos/packaging/**",
        "$TURBO_ROOT$/packages/desktop-platform-windows/packaging/**"
      ],
      "outputs": []
    },
    "@space/ui#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/badger/desktop/src/renderer/src/pages/**",
        "$TURBO_ROOT$/apps/badger/desktop/src/renderer/src/assets/fonts/**",
        "$TURBO_ROOT$/apps/parrot/desktop/src/renderer/src/main.tsx",
        "$TURBO_ROOT$/apps/parrot/desktop/src/renderer/src/styles.css"
      ],
      "outputs": []
    },
    "@space/badger-desktop#test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/mpv/**",
        "$TURBO_ROOT$/packages/media-deps/**",
        "$TURBO_ROOT$/packages/mobile-shell/**"
      ],
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "package": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "out/**",
        "dist/**"
      ]
    },
    "build:host": {
      "cache": true,
      "outputs": [
        "dist/**",
        "bin/**"
      ]
    }
  }
}
