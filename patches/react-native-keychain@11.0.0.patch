--- a/RNKeychain.podspec
+++ b/RNKeychain.podspec
@@ -17,7 +17,11 @@ Pod::Spec.new do |s|
   s.source         = { :git => "https://github.com/oblador/react-native-keychain.git", :tag => "v#{s.version}" }
   s.source_files   = 'ios/RNKeychainManager/**/*.{h,m,mm,cpp}'
   s.preserve_paths = "**/*.js"
-  s.frameworks     = 'Security', 'LocalAuthentication'
+  # SpaceFleet patch: tvOS has no LocalAuthentication framework, so only link it where it exists.
+  s.frameworks     = 'Security'
