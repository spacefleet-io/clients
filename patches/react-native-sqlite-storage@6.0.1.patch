diff --git a/platforms/ios/SQLite.m b/platforms/ios/SQLite.m
index 0cf0da4debed17c7b6df1e0b0477a5062522b045..e3b5302b95e5ba7ef438957673bfe255f1adad5d 100644
--- a/platforms/ios/SQLite.m
+++ b/platforms/ios/SQLite.m
@@ -85,7 +85,13 @@ RCT_EXPORT_MODULE();
     [appDBPaths retain];
 #endif
     
+#if TARGET_OS_TV
+    // tvOS apps may only write to Caches (Documents is read-only on Apple TV hardware): SpaceBadger's "Documents"
+    // databases live there, matching the app's own tvOS data folder.
+    NSString *docs = [NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES) objectAtIndex: 0];
+#else
     NSString *docs = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) objectAtIndex: 0];
+#endif
     RCTLog(@"Detected docs path: %@", docs);
     [appDBPaths setObject: docs forKey:@"docs"];
     
