{
  "name": "@space/badger-desktop",
  "license": "GPL-3.0-only",
  "productName": "Badger",
  "desktopName": "spacebadger.desktop",
  "version": "0.1.33",
  "description": "Badger desktop client",
  "author": "SpaceFleet",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "build:electron": "electron-vite build",
    "build:test": "VITE_SF_DEV_TICKET_KEY=1 electron-vite build",
    "check:renderer-budgets": "node ./scripts/check-renderer-budgets.mjs",
    "check:main-bundle": "node ./scripts/check-main-bundle.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "ci:desktop": "bun run typecheck && bun run lint && bun run build && bun run check:main-bundle && bun run check:renderer-budgets",
    "test": "bunx vitest run",
    "test:integration": "bunx vitest run tests/library-db-ipc.test.ts",
    "ensure:test-binaries": "node ./scripts/ensure-test-binaries.mjs",
    "test:integration:electron": "bun run ensure:test-binaries && bun run build:test && ../../../scripts/run-headless.sh bunx playwright test -c playwright.integration.config.ts",
    "test:integration:electron:headed": "bun run ensure:test-binaries && bun run build:test && bunx playwright test -c playwright.integration.config.ts --headed",
    "test:e2e": "env SF_BUGSINK_DSN_BADGER_DESKTOP=https://e2ekey@errors.e2e.invalid/1 SF_E2E_PLAYBACK_MAX_STARTUP_MS=15000 SF_E2E_CLICK_PLAY_MAX_MS=15000 sh -c 'bun run ensure:test-binaries && bun run build:test && ../../../scripts/run-headless.sh bunx playwright test -c playwright.electron.config.ts \"$@\"' sh",
    "test:e2e:headed": "env SF_BUGSINK_DSN_BADGER_DESKTOP=https://e2ekey@errors.e2e.invalid/1 SF_E2E_PLAYBACK_MAX_STARTUP_MS=15000 SF_E2E_CLICK_PLAY_MAX_MS=15000 sh -c 'bun run ensure:test-binaries && bun run build:test && bunx playwright test -c playwright.electron.config.ts --headed \"$@\"' sh",
    "test:e2e:storage-hygiene": "bunx playwright test -c playwright.electron.config.ts storage-hygiene",
    "test:e2e:ultimate": "bun ./e2e-ultimate/scripts/run-local.ts",
    "test:e2e:ultimate:sharded": "bun ./e2e-ultimate/scripts/run-sharded.ts",
    "preview": "electron-vite preview",
    "package": "node ./scripts/package.mjs --target linux-x64",
    "package:linux": "node ./scripts/package.mjs --target linux-x64",
    "package:windows": "node ./scripts/package.mjs --target windows-x64",
    "package:windows-test": "node ./scripts/package.mjs --target windows-x64 --test-build",
    "package:macos-arm64": "node ./scripts/package.mjs --target macos-arm64",
    "package:macos-x64": "node ./scripts/package.mjs --target macos-x64",
    "package:report-size": "node ./scripts/report-packaged-size.mjs",
    "memory:report": "bun run build && node ./scripts/report-memory-baseline.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "autoprefixer": "^10.6.1",
    "bun": "1.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "i18next": "^27.1.2",
    "lucide-react": "^1.73.0",
    "node-addon-api": "^8.9.2",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-json-view": "^1.21.3",
    "react-router-dom": "^7.18.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tailwind-merge": "^3.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@playwright/test": "~1.65.1",
    "playwright": "~1.65.1",
    "typescript-eslint": "^8.72.2",
    "@space/ffmpeg": "file:../../../packages/ffmpeg",
    "@space/ingest-core": "file:../../../packages/ingest-core",
    "@space/library-db-definition": "workspace:*",
    "@space/logger": "workspace:*",
    "@space/error-report": "workspace:*",
    "@space/metadata-client": "workspace:*",
    "@space/privacy-pass": "workspace:*",
    "@space/library-db-runtime": "workspace:*",
    "@space/mpv": "file:../../../packages/mpv",
    "@space/mpv-protocol": "workspace:*",
    "@space/pairing-crypto": "workspace:*",
    "@space/playback-abr": "workspace:*",
    "@space/runtime-client": "workspace:*",
    "@space/shared": "file:../../../packages/shared",
    "@space/stream-slots": "workspace:*",
    "@space/ui": "file:../../../packages/ui",
    "@space/desktop-shell": "workspace:*",
    "@space/legal": "workspace:*",
    "@space/desktop-mpv-playback": "workspace:*",
    "@space/media-session": "workspace:*",
    "@space/runtime-contracts": "workspace:*",
    "@space/runtime-host": "workspace:*",
    "@space/sdk": "workspace:*",
    "@space/tool-access": "workspace:*",
    "postgres": "^4.1.1",
    "@space/desktop-platform": "workspace:*"
  }
}
