<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required on Android 13 (API 33) and above so the system can deliver
         data-only FCM messages while the app is in the background. The
         runtime prompt is requested from JS the first time push is
         initialized; without this permission line the OS will silently drop
         pushes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Casting (UX-TV-03): find Cast devices on the Wi-Fi, and read the phone's Wi-Fi address the cast server listens on. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- One APK for phones and Android TV / Google TV / Fire TV (PLAT-TV-01, ADR 2026-10-16-tv-app-in-phone-app).
         TVs have no touchscreen and no camera; marking both optional keeps Google Play and the Amazon
         Appstore from hiding the app on TVs. Leanback is optional so phones still install it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:banner="@drawable/tv_banner"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:networkSecurityConfig="${networkSecurityConfig}"
      android:supportsRtl="true">
      <!-- Error reports are opt-in (REL-LOG-06): the Sentry SDK must never start itself, natively or otherwise. JS starts it
           only after the user says yes, and then only its JavaScript half (enableNative=false). -->
      <meta-data android:name="io.sentry.auto-init" android:value="false" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <!-- Shows the app on the Android TV / Google TV home screen. -->
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
        <!-- spacebadger://auth/provider?... brings the browser back from Google, Apple or Microsoft (ACCT-SIGNIN-05).
             spacebadger://pair?code=ABCDEFGH is the QR of desktops released before ACCT-PAIR-06's web link: kept until
             every desktop version that draws it is below the minimum supported version (REL-CD-08), then removed. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="spacebadger" android:host="pair" />
            <data android:scheme="spacebadger" android:host="auth" />
        </intent-filter>
        <!-- ACCT-PAIR-06: a Badger device's pairing QR, https://spacefleet.io/pair/badger?code=ABCD-EFGH, opens the
             approve screen. Only Badger's path: Parrot claims /pair/parrot. The website's
             /.well-known/assetlinks.json verifies it, so the link opens Badger without asking. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="spacefleet.io" android:pathPrefix="/pair/badger" />
        </intent-filter>
      </activity>
      <!-- Google Cast (UX-TV-03): Google's default media receiver, with the Badger glyph on the Cast notification
           (BadgerCastOptionsProvider). -->
      <meta-data
        android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
        android:value="com.spacebadger.mobile.BadgerCastOptionsProvider" />
    </application>
</manifest>
