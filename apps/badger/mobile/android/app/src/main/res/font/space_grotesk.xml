<?xml version="1.0" encoding="utf-8"?>
<!-- Static instances of the bundled variable font (Android picks weights from these; minSdk 26, so android: attributes suffice). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/space_grotesk_light"
        android:fontStyle="normal"
        android:fontWeight="300" />
    <font
        android:font="@font/space_grotesk_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/space_grotesk_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/space_grotesk_semi_bold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/space_grotesk_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
