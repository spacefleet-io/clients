<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.spacebadger" name="Badger repository" version="1.0.0" provider-name="Badger">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Badger">
    <dir minversion="19.0.0">
      <info compressed="false">@BASE_URL@/addons.xml</info>
      <checksum>@BASE_URL@/addons.xml.md5</checksum>
      <datadir zip="true">@BASE_URL@/addons/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Badger add-on updates</summary>
    <description lang="en_GB">Installs and updates the Badger add-on from spacebadger.io, so new versions arrive on their own.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <website>https://spacebadger.io</website>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
