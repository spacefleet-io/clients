# Strings not listed here fall back to resource.language.en_gb.
# ACCT-DEV-03: the saved-key question at sign-out
msgctxt "#30160"
msgid "Have you saved your media library key?"
msgstr "¿Guardaste la clave de tu mediateca?"

msgctxt "#30161"
msgid "Signing out removes your media library key, the cached library and the exported folder from this device. To sign back in you will have to type the key, because signing in with a QR code only works while another of your devices still has it. Without the key, your media library can't be opened."
msgstr "Al cerrar sesión se eliminan de este dispositivo la clave de tu mediateca, la mediateca guardada en caché y la carpeta exportada. Para volver a iniciar sesión tendrás que escribir la clave, porque iniciar sesión con un código QR solo funciona mientras otro de tus dispositivos todavía la tenga. Sin la clave, tu mediateca no se puede abrir."

msgctxt "#30162"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "#30163"
msgid "I saved it, sign out"
msgstr "Ya la guardé, cerrar sesión"

# PRIV-PAIR-01: the check code while pairing
msgctxt "#30113"
msgid "Code to check"
msgstr "Código de verificación"

msgctxt "#30114"
msgid "Compare it with your other device. Approve only if both show the same six digits."
msgstr "Compáralo con tu otro dispositivo. Aprueba solo si ambos muestran los mismos seis dígitos."
