# Strings not listed here fall back to resource.language.en_gb.
# ACCT-DEV-03: the saved-key question at sign-out
msgctxt "#30160"
msgid "Have you saved your media library key?"
msgstr "Hast du deinen Mediathek-Schlüssel gespeichert?"

msgctxt "#30161"
msgid "Signing out removes your media library key, the cached library and the exported folder from this device. To sign back in you will have to type the key, because signing in with a QR code only works while another of your devices still has it. Without the key, your media library can't be opened."
msgstr "Beim Abmelden werden dein Mediathek-Schlüssel, die zwischengespeicherte Mediathek und der exportierte Ordner von diesem Gerät entfernt. Um dich wieder anzumelden, musst du den Schlüssel eintippen, denn die Anmeldung per QR-Code klappt nur, solange eines deiner anderen Geräte ihn noch hat. Ohne den Schlüssel lässt sich deine Mediathek nicht öffnen."

msgctxt "#30162"
msgid "Cancel"
msgstr "Abbrechen"

msgctxt "#30163"
msgid "I saved it, sign out"
msgstr "Gespeichert, abmelden"

# PRIV-PAIR-01: the check code while pairing
msgctxt "#30113"
msgid "Code to check"
msgstr "Prüfcode"

msgctxt "#30114"
msgid "Compare it with your other device. Approve only if both show the same six digits."
msgstr "Vergleiche ihn mit deinem anderen Gerät. Bestätige nur, wenn beide dieselben sechs Ziffern zeigen."
