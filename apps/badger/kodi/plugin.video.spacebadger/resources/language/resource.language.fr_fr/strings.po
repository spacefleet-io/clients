# Strings not listed here fall back to resource.language.en_gb.
# ACCT-DEV-03: the saved-key question at sign-out
msgctxt "#30160"
msgid "Have you saved your media library key?"
msgstr "Avez-vous enregistré votre clé de médiathèque ?"

msgctxt "#30161"
msgid "Signing out removes your media library key, the cached library and the exported folder from this device. To sign back in you will have to type the key, because signing in with a QR code only works while another of your devices still has it. Without the key, your media library can't be opened."
msgstr "Se déconnecter retire de cet appareil votre clé de médiathèque, la bibliothèque en cache et le dossier exporté. Pour vous reconnecter, il faudra saisir la clé : la connexion par QR code ne marche que si un autre de vos appareils l'a encore. Sans elle, impossible d'ouvrir votre médiathèque."

msgctxt "#30162"
msgid "Cancel"
msgstr "Annuler"

msgctxt "#30163"
msgid "I saved it, sign out"
msgstr "Je l'ai enregistrée, me déconnecter"

# PRIV-PAIR-01: the check code while pairing
msgctxt "#30113"
msgid "Code to check"
msgstr "Code à vérifier"

msgctxt "#30114"
msgid "Compare it with your other device. Approve only if both show the same six digits."
msgstr "Comparez-le avec votre autre appareil. N’approuvez que si les deux affichent les mêmes six chiffres."
