{
  "name": "@space/parrot-desktop",
  "productName": "Parrot",
  "desktopName": "spaceparrot.desktop",
  "version": "0.1.41",
  "description": "Parrot desktop app: your own music, uploaded to your SpaceFleet storage and played anywhere",
  "author": "SpaceFleet",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "build:test": "VITE_SF_DEV_TICKET_KEY=1 electron-vite build",
    "check:main-bundle": "node ../../badger/desktop/scripts/check-main-bundle.mjs .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bunx vitest run",
    "test:e2e": "bun run build:test && ../../../scripts/run-headless.sh bunx playwright test -c playwright.electron.config.ts",
    "package:linux": "node ./scripts/package.mjs --target linux-x64",
    "package:windows": "node ./scripts/package.mjs --target windows-x64",
    "package:windows-test": "node ./scripts/package.mjs --target windows-x64 --test-build",
    "package:macos-arm64": "node ./scripts/package.mjs --target macos-arm64",
    "package:macos-x64": "node ./scripts/package.mjs --target macos-x64"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@space/desktop-platform": "workspace:*",
    "@space/desktop-shell": "workspace:*",
    "@space/legal": "workspace:*",
    "@space/error-report": "workspace:*",
    "@space/library-db-runtime": "workspace:*",
    "@space/media-session": "workspace:*",
    "@space/metadata-client": "workspace:*",
    "@space/pairing-crypto": "workspace:*",
    "@space/parrot-core": "workspace:*",
    "@space/parrot-ingest": "workspace:*",
    "@space/parrot-library-db-definition": "workspace:*",
    "@space/privacy-pass": "workspace:*",
    "@space/shared": "file:../../../packages/shared",
    "@space/stream-slots": "workspace:*",
    "@space/ui": "file:../../../packages/ui",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.1",
    "electron-updater": "^6.8.12",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.73.0",
    "playwright": "~1.65.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
