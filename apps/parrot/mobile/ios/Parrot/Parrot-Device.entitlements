<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ACCT-PAIR-06: the pairing QR is https://spacefleet.io/pair/<app>?code=...; the site's
		 /.well-known/apple-app-site-association gives each app only its own /pair/<app> path.
		 Only referenced for sdk=iphoneos* (device builds). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:spacefleet.io</string>
	</array>
	<!-- ACCT-PAIR-07: same-device sign-in. The app's own group stays first (the default group of every keychain item
		 the app writes); the team's shared group holds only the sign-in status ({email, userId}) and, for a few
		 seconds, the answer to a same-device sign-in request. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(AppIdentifierPrefix)io.spacefleet.shared</string>
	</array>
</dict>
</plist>
