<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: no cleartext, except the app's own on-device media proxy on 127.0.0.1, which ExoPlayer
  streams songs from over plain http (without this, playback fails with ERROR_CODE_IO_CLEARTEXT_NOT_PERMITTED).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
